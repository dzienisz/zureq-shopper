{
  "manifest_version": 3,
  "name": "Zureq Shopper",
  "version": "1.0.0",
  "description": "Search products and compare markets with the Zureq MCP API.",
  "permissions": ["storage", "contextMenus", "sidePanel"],
  "host_permissions": ["https://api.zureq.io/*"],
  "content_scripts": [
    {
      "matches": [
        "https://allegro.pl/oferta/*",
        "https://allegro.pl/produkt/*",
        "https://www.amazon.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": ["pagescan.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Zureq Shopper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
