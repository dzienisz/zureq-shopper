{
  "manifest_version": 3,
  "name": "ZUREQ Shopper",
  "version": "1.2.0",
  "description": "Search products across Zureq shops, compare markets, plan builds, and find cheaper options on Allegro and Amazon.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "contextMenus", "sidePanel", "alarms", "notifications"],
  "host_permissions": ["https://api.zureq.io/*"],
  "content_scripts": [
    {
      "matches": [
        "https://allegro.pl/oferta/*",
        "https://allegro.pl/produkt/*",
        "https://www.amazon.com/*",
        "https://www.amazon.de/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.co.uk/*",
        "https://www.ceneo.pl/*",
        "https://www.ebay.com/itm/*",
        "https://www.ebay.de/itm/*",
        "https://www.ebay.pl/itm/*",
        "https://www.ebay.co.uk/itm/*",
        "https://www.x-kom.pl/p/*",
        "https://www.mediaexpert.pl/*"
      ],
      "js": ["pagescan.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open ZUREQ Shopper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
